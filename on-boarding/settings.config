# ============================================================
# settings.config
# Environment/credentials file for the local AWS training stack.
#
# Usage:
#   docker compose --env-file settings.config up -d
#
# IMPORTANT: change every "changeme_*" value below before use,
# and do NOT commit this file once real passwords are set
# (see .gitignore).
# ============================================================

# ---------- Floci AWS (LocalStack) ----------
FLOCI_AWS_ACCESS_KEY_ID=test
FLOCI_AWS_SECRET_ACCESS_KEY=changeme_floci_secret
FLOCI_AWS_DEFAULT_REGION=us-east-1
FLOCI_EDGE_PORT=4566
# "rds" is a LocalStack Pro-only service and crashes the container without
# a license token, so it's left out here. Add it back (and set
# FLOCI_AUTH_TOKEN below) once you have a LocalStack Pro token.
FLOCI_SERVICES=s3,lambda,dynamodb,sqs,sns,iam,cloudwatch,logs
# Optional: only needed to unlock LocalStack Pro-only services (e.g. rds).
# Get one at https://app.localstack.cloud - leave blank for the free tier.
FLOCI_AUTH_TOKEN=

# ---------- PySpark cluster ----------
# Note: the local Spark master/worker UIs are unauthenticated (standard
# apache/spark image, no built-in login) - fine for a local training stack
# not exposed off your machine.
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ---------- PySpark UI / Jupyter notebook ----------
JUPYTER_PORT=8888
PYSPARK_UI_PORT=4040
PYSPARK_JUPYTER_TOKEN=changeme_pyspark_jupyter_token

# ---------- Kafka ----------
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
# Avoid double quotes, backslashes, or $ in this password - it's embedded
# literally into a generated JAAS config file.
KAFKA_SASL_USERNAME=kafka_admin
KAFKA_SASL_PASSWORD=changeme_kafka_pass
# Any 22-char base64 string identifies a fresh KRaft cluster on first boot.
# Generate your own with: docker run --rm confluentinc/cp-kafka:7.6.13 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---------- Netdata ----------
NETDATA_PORT=19999
# Optional: only needed if you want this node to stream into Netdata Cloud
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# ---------- FTP server ----------
FTP_PORT=21
FTP_PASSIVE_PORT_RANGE=30000-30009
FTP_USER_NAME=ftpadmin
FTP_USER_PASS=changeme_ftp_pass
FTP_USER_HOME=/home/ftpuser
